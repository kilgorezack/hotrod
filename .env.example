# Apple MapKit JS token (required)
# Generate at: https://developer.apple.com/account/resources/authkeys/list
# See README.md for token generation instructions
# Recommended: let the server sign short-lived tokens on demand (never expires).
# Set these as Vercel project env vars (or Worker secrets). The private key is the
# full contents of AuthKey_XXXXXXXXXX.p8; literal "\n" escapes are accepted.
# MAPKIT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# MAPKIT_TEAM_ID=XXXXXXXXXX
# MAPKIT_KEY_ID=XXXXXXXXXX

# Fallback: a pre-generated JWT baked in at build time (expires after 180 days)
MAPKIT_TOKEN=your_apple_mapkit_jwt_here

# Server port (optional, defaults to 3001)
PORT=3001

# Node environment
NODE_ENV=development

# Firebase Storage (for nationwide broadband data)
# FIREBASE_STORAGE_BASE=https://storage.googleapis.com/your-bucket-name
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}  <- import script only
